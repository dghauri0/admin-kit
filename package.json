{
  "name": "admin-kit",
  "version": "1.0.0",
  "description": "Brand-neutral admin control kit: dropdown, checkbox, toggle, auto-grow textarea, modal, toast, date/time. Ships behaviour and token names; consumers supply token values.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": "./dist/strings.js",
    "./css": "./dist/admin-kit.css",
    "./js": "./dist/admin-kit.js",
    "./html": "./dist/admin-kit.html",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint:neutral": "node scripts/check-brand-neutral.mjs",
    "test": "vitest run && npm run lint:neutral",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "happy-dom": "^20.9.0",
    "vitest": "^2.1.0"
  }
}
